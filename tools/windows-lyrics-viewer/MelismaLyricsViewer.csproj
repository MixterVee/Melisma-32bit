<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MelismaLyricsViewer</AssemblyName>
    <Version>0.6.17</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationTitle>Melisma Universal Lyrics Preview</ApplicationTitle>
  </PropertyGroup>
  <!-- The nested standalone smoke-test project has its own Program/obj.
       Exclude it from this WinForms application's default wildcard glob. -->
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
</Project>
